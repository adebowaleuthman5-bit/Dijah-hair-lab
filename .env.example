# Copy this file to .env and fill in your real Supabase project values.
# Find these in your Supabase project: Settings -> API.
#
# If these are left unset (or .env doesn't exist), the app automatically
# falls back to the built-in demo data — nothing breaks, you just won't
# be talking to a real database yet. See supabase/README.md for how to
# set up the schema this app expects.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
